    </div>

    <!-- Edge Navigation Controls (Left & Right - displayed on sm+) -->
    <button type="button" id="heroPrevBtn" class="hidden sm:flex absolute left-4 sm:left-8 top-1/2 -translate-y-1/2 z-30 w-11 h-11 rounded-full bg-white/90 hover:bg-white text-emerald-900 border border-emerald-200 items-center justify-center transition-all duration-300 hover:scale-105 shadow-md shadow-emerald-950/5" aria-label="Slide Précédente">
        <span class="material-symbols-outlined text-2xl text-[#15803D]">chevron_left</span>
    </button>
    <button type="button" id="heroNextBtn" class="hidden sm:flex absolute right-4 sm:right-8 top-1/2 -translate-y-1/2 z-30 w-11 h-11 rounded-full bg-white/90 hover:bg-white text-emerald-900 border border-emerald-200 items-center justify-center transition-all duration-300 hover:scale-105 shadow-md shadow-emerald-950/5" aria-label="Slide Suivante">
        <span class="material-symbols-outlined text-2xl text-[#15803D]">chevron_right</span>
    </button>

    <!-- Minimalist Slide Indicators with Green Brand DNA -->
    <div class="absolute bottom-2.5 sm:bottom-4 left-1/2 -translate-x-1/2 z-30 flex items-center gap-2">
        <button type="button" class="hero-dot w-7 h-2.5 rounded-full bg-[#15803D] shadow-sm shadow-emerald-700/40 ring-2 ring-emerald-200 transition-all duration-300" data-index="0" aria-label="Aller à la slide 1"></button>
        <button type="button" class="hero-dot w-2.5 h-2.5 rounded-full bg-emerald-200 hover:bg-emerald-300 transition-all duration-300" data-index="1" aria-label="Aller à la slide 2"></button>
        <button type="button" class="hero-dot w-2.5 h-2.5 rounded-full bg-emerald-200 hover:bg-emerald-300 transition-all duration-300" data-index="2" aria-label="Aller à la slide 3"></button>
    </div>
</section>

<main class="max-w-[1280px] mx-auto px-3 sm:px-6 md:px-margin-desktop space-y-12 sm:space-y-16 py-8 md:py-14 reveal-up">

    <!-- Category Shortcuts: Big Circular Icon Avatars Showcase -->
    <section class="space-y-4 sm:space-y-5">
        <div class="flex justify-between items-end border-b border-slate-100 pb-3">
            <div>
                <span class="text-[9px] sm:text-[10px] text-slate-400 font-bold uppercase tracking-[0.25em] block mb-0.5">Univers de Soin</span>
                <h3 class="font-editorial text-lg sm:text-2xl md:text-3xl text-slate-900 font-bold tracking-tight">Explorer par Catégorie</h3>
            </div>
            <a asp-controller="Products" asp-action="Index" class="text-[10px] sm:text-xs font-bold uppercase tracking-widest text-[#15803D] hover:text-[#166534] transition-colors flex items-center gap-1 border-b border-[#15803D] pb-0.5 flex-shrink-0">
                <span>Tout Voir</span>
                <span class="material-symbols-outlined text-xs">arrow_forward</span>
            </a>
        </div>

        <!-- Big Circular Icon Avatars -->
        <div class="grid grid-cols-5 sm:grid-cols-5 md:grid-cols-9 gap-2 sm:gap-3.5 py-2">
            @foreach (var cat in Model.Categories)
            {
                <a asp-controller="Products" asp-action="Index" asp-route-category="@cat.Slug" class="group flex flex-col items-center gap-2 sm:gap-2.5 text-center transition-all duration-300">
                    <div class="w-13 h-13 sm:w-16 sm:h-16 md:w-20 md:h-20 rounded-full bg-white border border-slate-200/90 p-2.5 sm:p-3.5 flex items-center justify-center overflow-hidden transition-all duration-300 group-hover:border-slate-900 group-hover:scale-105 shadow-[0_2px_10px_rgba(0,0,0,0.03)] group-hover:shadow-md ring-1 ring-slate-100 flex-shrink-0">
                        @if (cat.Icon.StartsWith("/") || cat.Icon.StartsWith("http"))
                        {
                            <img src="@cat.Icon" alt="@cat.Name" class="w-full h-full object-cover rounded-full" />
                        }
                        else
                        {
                            <span class="material-symbols-outlined text-2xl sm:text-3xl md:text-4xl text-slate-800 group-hover:text-black transition-colors">@cat.Icon</span>
                        }
                    </div>
                    <span class="text-[8px] sm:text-[10px] md:text-[11px] text-slate-700 font-semibold tracking-tight uppercase group-hover:text-black transition-colors leading-tight line-clamp-2 text-center w-full px-0.5">@cat.Name</span>
                </a>
            }
        </div>
    </section>

    <!-- SECTION: NOS OFFRES SPÉCIALES (Dynamic from Admin) -->
    @if (Model.PromotionalOffers != null && Model.PromotionalOffers.Any())
    {
        <section class="space-y-5 sm:space-y-6">
            <!-- Header -->
            <div class="flex items-end justify-between border-b border-slate-200/90 pb-3 sm:pb-4 gap-2">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 bg-red-600 text-white text-[8px] sm:text-[9px] font-bold uppercase tracking-[0.18em] rounded-full shadow-xs">
                            <span class="material-symbols-outlined text-[11px]" style="font-variation-settings: 'FILL' 1;">local_fire_department</span>
                            Offres Limitées
                        </span>
                        <span class="text-[9px] sm:text-[10px] text-slate-400 font-bold uppercase tracking-widest">Jusqu'à -30%</span>
                    </div>
                    <h2 class="font-editorial text-xl sm:text-3xl md:text-4xl text-slate-900 font-bold tracking-tight">
                        Nos Offres Spéciales
                    </h2>
                </div>
                <a asp-controller="Products" asp-action="Index" class="text-[10.5px] sm:text-xs font-bold uppercase tracking-widest text-[#15803D] hover:text-[#166534] transition-colors flex items-center gap-1 border-b border-[#15803D] pb-0.5 flex-shrink-0">
                    <span>Voir Tout</span>
                    <span class="material-symbols-outlined text-xs">arrow_forward</span>
                </a>
            </div>

            <!-- Luxury Spotlight Promo Cards: Mobile Snap Carousel & Desktop 3-Column Grid -->
            <div class="relative">
                <!-- Snap Scroll Track -->
                <div id="promoCarouselTrack" class="flex overflow-x-auto snap-x snap-mandatory gap-3.5 pb-2 px-4 -mx-4 hide-scrollbar md:mx-0 md:px-0 md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-6 md:pb-0">
                    @foreach (var offer in Model.PromotionalOffers)
                    {
                        <div class="w-[80vw] max-w-[320px] sm:w-[340px] md:w-auto shrink-0 snap-center relative rounded-2xl sm:rounded-3xl overflow-hidden bg-slate-950 text-white p-5 sm:p-6 flex flex-col justify-between h-[290px] sm:h-[320px] border border-slate-800 shadow-lg group hover-lift">
                            <div class="absolute inset-0 z-0 opacity-45 bg-cover bg-center transition-transform duration-700 group-hover:scale-105" style="background-image: url('@offer.ImageUrl');"></div>
                            <div class="absolute inset-0 z-0 bg-gradient-to-t from-slate-950 via-slate-950/75 to-slate-950/30"></div>

                            <div class="relative z-10 space-y-1.5">
                                <span class="inline-block bg-white/20 backdrop-blur-md border border-white/25 text-white text-[8.5px] font-bold uppercase tracking-[0.16em] px-2.5 py-0.5 rounded-full shadow-xs">
                                    @offer.Badge
                                </span>
                                <h3 class="font-editorial text-lg sm:text-xl font-bold text-white leading-tight">
                                    @offer.Title
                                </h3>
                                @if (!string.IsNullOrWhiteSpace(offer.Description))
                                {
                                    <p class="text-[11px] text-slate-200 font-light leading-snug line-clamp-2">
                                        @offer.Description
                                    </p>
                                }
                            </div>

                            <div class="relative z-10 pt-3 flex items-center justify-between gap-2 border-t border-white/15 mt-2">
                                <div class="min-w-0">
                                    @if (offer.OriginalPrice > 0)
                                    {
                                        <div class="text-[9px] text-slate-400 font-medium line-through">@offer.OriginalPrice.ToString("F2") Dinar</div>
                                    }
                                    <div class="font-editorial text-lg sm:text-xl font-bold text-white truncate">@offer.PromoPrice.ToString("F2") Dinar</div>
                                </div>
                                @if (offer.AssociatedProductId.HasValue && offer.AssociatedProductId.Value > 0)
                                {
                                    <button onclick="addToCart(@offer.AssociatedProductId.Value, 1)" class="bg-white hover:bg-slate-100 text-slate-900 text-[10px] sm:text-[11px] font-bold uppercase tracking-wider px-3.5 py-2 rounded-xl transition-all flex items-center gap-1 shadow-md flex-shrink-0 cursor-pointer">
                                        <span class="material-symbols-outlined text-sm">shopping_bag</span>
                                        <span>Ajouter</span>
                                    </button>
                                }
                                else
                                {
                                    <a asp-controller="Products" asp-action="Index" class="bg-white hover:bg-slate-100 text-slate-900 text-[10px] sm:text-[11px] font-bold uppercase tracking-wider px-3.5 py-2 rounded-xl transition-all flex items-center gap-1 shadow-md flex-shrink-0">
                                        <span>Découvrir</span>
                                        <span class="material-symbols-outlined text-xs">arrow_forward</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Mobile Carousel Indicators -->
                <div class="flex md:hidden items-center justify-center gap-1.5 pt-3" id="promoCarouselDots">
                    @for (int i = 0; i < Model.PromotionalOffers.Count; i++)
                    {
                        <span class="promo-dot @(i == 0 ? "w-6 bg-[#15803D]" : "w-2 bg-slate-300") h-1.5 rounded-full transition-all duration-300"></span>
                    }
                </div>
            </div>
        </section>
    }

    <!-- SECTION: NOS SOINS EN VIDÉO / STORIES GRANDES MARQUES (Dynamic from Admin) -->
    @if (Model.StoryReels != null && Model.StoryReels.Any())
    {
        <section class="space-y-6">
            <!-- Header -->
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-slate-200 pb-4">
                <div>
                    <div class="flex items-center gap-2 mb-1.5">
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#15803D] text-white text-[9px] font-bold uppercase tracking-[0.2em] rounded-full shadow-sm">
                            <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
                            Stories &bull; Rituels en Direct
                        </span>
                        <span class="hidden sm:inline text-[10px] text-slate-400 font-bold uppercase tracking-widest">Démonstrations des Grandes Marques</span>
                    </div>
                    <h2 class="font-editorial text-3xl sm:text-4xl text-slate-900 font-bold tracking-tight">
                        Nos Soins en Démonstration
                    </h2>
                </div>
                <p class="text-xs text-slate-500 max-w-xs sm:text-right font-light">
                    Découvrez la texture, la gestuelle d'application et l'efficacité des formules de nos grands laboratoires.
                </p>
            </div>

            <!-- Story / Reel Cards Grid (Autoplaying like FB/Insta Stories) -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
                @foreach (var story in Model.StoryReels)
                {
                    <div class="reel-card group relative rounded-[28px] overflow-hidden bg-slate-950 text-white min-h-[540px] shadow-[0_20px_45px_rgba(0,0,0,0.14)] border border-slate-800 flex flex-col justify-between p-6 transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_25px_55px_rgba(0,0,0,0.22)]">
                        
                        <!-- Autoplay Video Background (Continuous Loop) -->
                        <video autoplay muted loop playsinline preload="auto" onended="this.currentTime = 0; this.play();" poster="@story.PosterUrl" class="reel-video absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105">
                            <source src="@story.VideoUrl" type="video/mp4" />
                        </video>
                        <div class="absolute inset-0 z-0 bg-gradient-to-t from-black/50 via-transparent to-black/50 pointer-events-none"></div>

                        <!-- Top: Brand Badges & Sound Toggle -->
                        <div class="relative z-10 flex items-center justify-between">
                            <span class="px-3 py-1 rounded-full text-white text-[9px] font-bold uppercase tracking-widest flex items-center gap-1.5 shadow-md backdrop-blur-md @(story.BadgeColor == "emerald" ? "bg-emerald-600/90" : story.BadgeColor == "teal" ? "bg-teal-600/90" : story.BadgeColor == "amber" ? "bg-amber-600/90" : story.BadgeColor == "indigo" ? "bg-indigo-600/90" : "bg-red-600/90")">
                                <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
                                <span>@story.BadgeText</span>
                            </span>
                            
                            <!-- Sound Toggle / Control -->
                            <button type="button" onclick="toggleReelSound(this)" class="w-8 h-8 rounded-full bg-black/60 hover:bg-black/90 backdrop-blur-md border border-white/20 flex items-center justify-center transition-all cursor-pointer shadow-lg" title="Activer / Couper le son">
                                <span class="material-symbols-outlined text-sm reel-sound-icon text-white">volume_off</span>
                            </button>
                        </div>

                        <!-- Center: Discrete Play/Pause Control on Click -->
                        <div class="relative z-10 flex flex-col items-center justify-center my-auto py-8">
                            <button type="button" onclick="toggleReelVideo(this)" class="w-14 h-14 rounded-full bg-black/40 hover:bg-black/70 text-white border border-white/30 flex items-center justify-center backdrop-blur-md transition-all duration-300 opacity-0 group-hover:opacity-100 hover:scale-110 cursor-pointer" aria-label="Pause / Reprendre">
                                <span class="material-symbols-outlined text-2xl reel-play-icon">pause</span>
                            </button>
                        </div>

                        <!-- Bottom: Story Title / Product if any -->
                        @if (!string.IsNullOrWhiteSpace(story.Title) || story.AssociatedProductId.HasValue)
                        {
                            <div class="relative z-10 space-y-1 bg-black/40 backdrop-blur-md p-3.5 rounded-2xl border border-white/10 mt-auto">
                                <div class="text-[9.5px] font-bold uppercase tracking-wider text-amber-300">Laboratoire @story.BrandName</div>
                                <div class="text-xs font-bold text-white line-clamp-1">@story.Title</div>
                                @if (story.AssociatedProductId.HasValue && story.AssociatedProductId.Value > 0)
                                {
                                    <div class="pt-1.5 flex items-center justify-between">
                                        <span class="text-[9.5px] text-slate-300">Démonstration Soin</span>
                                        <button onclick="addToCart(@story.AssociatedProductId.Value, 1)" class="px-2.5 py-1 rounded-lg bg-white hover:bg-slate-100 text-slate-900 text-[9.5px] font-bold uppercase tracking-wider flex items-center gap-1 transition-all cursor-pointer">
                                            <span class="material-symbols-outlined text-xs">shopping_bag</span>
                                            <span>Panier</span>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    }
    <!-- Fast & Simple Ordering Banner (Sleek Dark Luxury Identity) -->
    <section class="relative rounded-3xl overflow-hidden bg-[#090D16] text-white p-8 md:p-14 border border-slate-800 shadow-2xl">
        <!-- Subtle Ambient Glow -->
        <div class="absolute -top-24 -right-24 w-72 h-72 bg-emerald-600/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-slate-700/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="max-w-2xl space-y-5 z-10 relative">
            <span class="inline-flex items-center gap-2 px-3.5 py-1 bg-slate-800/80 border border-slate-700 rounded-full text-[9px] font-bold tracking-[0.25em] uppercase text-emerald-400">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                Commande Express &bull; Sans Compte
            </span>
            <h2 class="font-editorial text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight leading-tight">
                Commandez en Quelques Clics, <span class="italic font-normal text-slate-200">Sans Formalités</span>
            </h2>
            <p class="text-xs sm:text-sm text-slate-400 font-light max-w-lg leading-relaxed">
                Aucun compte obligatoire à créer, aucune démarche superflue : sélectionnez vos soins et confirmez directement vos achats en toute sérénité.
            </p>
            <div class="pt-3 flex flex-wrap items-center gap-4">
                <a asp-controller="Products" asp-action="Index" class="inline-flex items-center gap-2 bg-white text-slate-950 text-[10.5px] font-bold uppercase tracking-[0.18em] px-8 py-4 rounded-xl hover:bg-emerald-50 hover:text-[#15803D] transition-all shadow-lg hover:scale-[1.02]">
                    <span class="material-symbols-outlined text-base">shopping_bag</span> Commander Maintenant
                </a>
                <button type="button" onclick="openCartDrawer()" class="inline-flex items-center gap-2 bg-slate-900 border border-slate-700 hover:border-slate-500 text-slate-200 text-[10.5px] font-bold uppercase tracking-[0.18em] px-6 py-4 rounded-xl transition-all">
                    <span class="material-symbols-outlined text-base">shopping_cart</span> Mon Panier
                </button>
            </div>
            <div class="pt-2 flex items-center gap-6 text-[11px] text-slate-400 font-light">
                <span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-xs text-emerald-400">check_circle</span> 100% Officinal</span>
                <span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-xs text-emerald-400">check_circle</span> Traitement Immédiat</span>
                <span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-xs text-emerald-400">check_circle</span> Paiement à la Livraison</span>
            </div>
        </div>
    </section>

    <!-- Trust Badges -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6 py-6 border-t border-slate-200 mt-8">
        <div class="flex items-center gap-4 p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover-lift group">
            <div class="w-12 h-12 rounded-full bg-slate-50 border border-slate-200 text-slate-900 flex items-center justify-center flex-shrink-0 group-hover:bg-black group-hover:text-white transition-all">
                <span class="material-symbols-outlined text-[24px]">verified</span>
            </div>
            <div>
                <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Origine Officinale</h4>
                <p class="text-[10px] text-slate-500 font-light mt-0.5 leading-relaxed">Produits 100% authentiques issus directement des laboratoires.</p>
            </div>
        </div>

        <div class="flex items-center gap-4 p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover-lift group">
            <div class="w-12 h-12 rounded-full bg-slate-50 border border-slate-200 text-slate-900 flex items-center justify-center flex-shrink-0 group-hover:bg-black group-hover:text-white transition-all">
                <span class="material-symbols-outlined text-[24px]">payments</span>
            </div>
            <div>
                <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Paiement à la Livraison</h4>
                <p class="text-[10px] text-slate-500 font-light mt-0.5 leading-relaxed">Réglez vos achats en toute confiance directement à la réception de votre colis.</p>
            </div>
        </div>

        <div class="flex items-center gap-4 p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover-lift group">
            <div class="w-12 h-12 rounded-full bg-slate-50 border border-slate-200 text-slate-900 flex items-center justify-center flex-shrink-0 group-hover:bg-black group-hover:text-white transition-all">
                <span class="material-symbols-outlined text-[24px]">local_pharmacy</span>
            </div>
            <div>
                <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Conseil Pharmacien</h4>
                <p class="text-[10px] text-slate-500 font-light mt-0.5 leading-relaxed">Équipe d'experts disponibles en permanence.</p>
            </div>
        </div>
    </section>
</main>
