            <div>
                <span class="text-xs font-bold text-emerald-700 block mb-0.5">Rayons Officinaux</span>
                <h3 class="font-editorial text-lg sm:text-2xl md:text-3xl text-slate-900 font-bold tracking-tight">Explorer par Catégorie</h3>
            </div>
            <a asp-controller="Products" asp-action="Index" class="text-xs sm:text-sm font-semibold text-[#15803D] hover:text-[#166534] transition-colors flex items-center gap-1">
                <span>Tout voir</span>
                <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </a>
        </div>

        <!-- Big Circular Icon Avatars -->
        <div class="grid grid-cols-5 sm:grid-cols-5 md:grid-cols-9 gap-2 sm:gap-3.5 py-2">
            @foreach (var cat in Model.Categories)
            {
                <a asp-controller="Products" asp-action="Index" asp-route-category="@cat.Slug" class="group flex flex-col items-center gap-2 sm:gap-2.5 text-center transition-all duration-300">
                    <div class="w-13 h-13 sm:w-16 sm:h-16 md:w-20 md:h-20 rounded-full bg-white border border-slate-200/90 p-2.5 sm:p-3.5 flex items-center justify-center overflow-hidden transition-all duration-300 group-hover:border-slate-900 group-hover:scale-105 shadow-[0_2px_10px_rgba(0,0,0,0.03)] group-hover:shadow-md ring-1 ring-slate-100 flex-shrink-0">
                        @if (cat.Icon.StartsWith("/") || cat.Icon.StartsWith("http"))
                        {
                            <img src="@cat.Icon" alt="@cat.Name" class="w-full h-full object-cover rounded-full" />
                        }
                        else
                        {
                            <span class="material-symbols-outlined text-2xl sm:text-3xl md:text-4xl text-slate-800 group-hover:text-black transition-colors">@cat.Icon</span>
                        }
                    </div>
                    <span class="text-xs text-slate-700 font-medium group-hover:text-black transition-colors leading-tight line-clamp-2 text-center w-full px-0.5">@cat.Name</span>
                </a>
            }
        </div>
    </section>

    <!-- SECTION: NOS OFFRES SPÉCIALES (Dynamic from Admin) -->
    @if (Model.PromotionalOffers != null && Model.PromotionalOffers.Any())
    {
        <section class="space-y-4 sm:space-y-6">
            <!-- Header -->
            <div class="flex items-center justify-between border-b border-slate-200/80 pb-3 gap-2">
                <div>
                    <div class="flex items-center gap-1.5 text-xs font-bold text-[#15803D] uppercase tracking-wider mb-0.5">
                        <span class="w-2 h-2 rounded-full bg-[#15803D]"></span>
                        <span>Sélections Privilèges</span>
                    </div>
                    <h2 class="font-editorial text-xl sm:text-3xl md:text-4xl text-slate-900 font-bold tracking-tight">
                        Nos Offres Spéciales
                    </h2>
                </div>
                <a asp-controller="Products" asp-action="Index" class="text-xs sm:text-sm font-semibold text-[#15803D] hover:text-[#166534] transition-colors flex items-center gap-1 bg-emerald-50 hover:bg-emerald-100/70 px-3 py-1.5 rounded-xl">
                    <span>Tout voir</span>
                    <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </a>
            </div>

            <!-- Offers Showcase: Perfect 2-Column Grid on Mobile, 3-Column on Desktop (No awkward side cut-off) -->
            <div class="grid grid-cols-2 md:grid-cols-3 gap-2.5 sm:gap-4 md:gap-6">
                @foreach (var offer in Model.PromotionalOffers)
                {
                    <!-- Card: Luminous Clean on Mobile, Obsidian Spotlight on Desktop -->
                    <div class="relative rounded-2xl md:rounded-3xl overflow-hidden bg-white md:bg-slate-950 text-slate-900 md:text-white border border-slate-200/90 md:border-slate-800 shadow-sm md:shadow-xl flex flex-col justify-between group hover-lift transition-all duration-300">
                        
                        <!-- DESKTOP BACKGROUND ART (Hidden on Mobile) -->
                        <div class="hidden md:block absolute inset-0 z-0 opacity-45 bg-cover bg-center transition-transform duration-700 group-hover:scale-105" style="background-image: url('@offer.ImageUrl');"></div>
                        <div class="hidden md:block absolute inset-0 z-0 bg-gradient-to-t from-slate-950 via-slate-950/75 to-slate-950/30"></div>

                        <!-- MOBILE CLEAN 2-COLUMN CARD (< md) -->
                        <div class="block md:hidden p-2.5 sm:p-3.5 flex flex-col justify-between h-full">
                            <div class="relative w-full aspect-square rounded-xl overflow-hidden bg-white border border-slate-100 flex items-center justify-center mb-2">
                                <img src="@offer.ImageUrl" alt="@offer.Title" class="w-full h-full object-cover scale-[1.12] transition-transform duration-500 group-hover:scale-[1.20]" loading="lazy" />
                                <span class="absolute top-1.5 left-1.5 bg-[#15803D] text-white text-[9px] font-bold px-1.5 py-0.5 rounded-md shadow-xs flex items-center gap-0.5">
                                    <span class="material-symbols-outlined text-[10px]">local_offer</span>
                                    @offer.Badge
                                </span>
                            </div>
                            
                            <div class="space-y-0.5 mb-2">
                                <h3 class="font-editorial text-xs sm:text-sm font-bold text-slate-900 leading-snug line-clamp-2">
                                    @offer.Title
                                </h3>
                                @if (!string.IsNullOrWhiteSpace(offer.Description))
                                {
                                    <p class="text-[10px] text-slate-500 line-clamp-1 font-normal">
                                        @offer.Description
                                    </p>
                                }
                            </div>

                            <div class="pt-2 border-t border-slate-100 mt-auto">
                                <div class="mb-1.5">
                                    @if (offer.OriginalPrice > 0)
                                    {
                                        <div class="text-[9.5px] text-slate-400 line-through">@offer.OriginalPrice.ToString("F2") DZD</div>
                                    }
                                    <div class="text-xs sm:text-sm font-bold text-[#15803D] truncate">@offer.PromoPrice.ToString("F2") DZD</div>
                                </div>
                                @if (offer.AssociatedProductId.HasValue && offer.AssociatedProductId.Value > 0)
                                {
                                    <button onclick="addToCart(@offer.AssociatedProductId.Value, 1)" class="w-full bg-[#15803D] hover:bg-[#166534] text-white text-[11px] font-semibold py-1.5 px-2 rounded-lg transition-all flex items-center justify-center gap-1 shadow-xs cursor-pointer">
                                        <span class="material-symbols-outlined text-xs">shopping_bag</span>
                                        <span>Ajouter</span>
                                    </button>
                                }
                                else
                                {
                                    <a asp-controller="Products" asp-action="Index" class="w-full bg-slate-900 hover:bg-black text-white text-[11px] font-semibold py-1.5 px-2 rounded-lg transition-all flex items-center justify-center gap-1 shadow-xs">
                                        <span>Voir</span>
                                        <span class="material-symbols-outlined text-xs">arrow_forward</span>
                                    </a>
                                }
                            </div>
                        </div>

                        <!-- DESKTOP LUXURY SPOTLIGHT CONTENT (>= md) -->
                        <div class="hidden md:flex flex-col justify-between h-[300px] lg:h-[320px] p-6 relative z-10">
                            <div class="space-y-1.5">
                                <span class="text-xs font-semibold text-emerald-300 block">
                                    @offer.Badge
                                </span>
                                <h3 class="font-editorial text-xl font-bold text-white leading-tight">
                                    @offer.Title
                                </h3>
                                @if (!string.IsNullOrWhiteSpace(offer.Description))
                                {
                                    <p class="text-xs text-slate-200 font-normal leading-snug line-clamp-2">
                                        @offer.Description
                                    </p>
                                }
                            </div>

                            <div class="pt-3 flex items-center justify-between gap-2 border-t border-white/15 mt-2">
                                <div class="min-w-0">
                                    @if (offer.OriginalPrice > 0)
                                    {
                                        <div class="text-xs text-slate-400 line-through">@offer.OriginalPrice.ToString("F2") Dinar</div>
                                    }
                                    <div class="text-xl font-bold text-white tracking-tight truncate">@offer.PromoPrice.ToString("F2") Dinar</div>
                                </div>
                                @if (offer.AssociatedProductId.HasValue && offer.AssociatedProductId.Value > 0)
                                {
                                    <button onclick="addToCart(@offer.AssociatedProductId.Value, 1)" class="bg-white hover:bg-slate-100 text-slate-900 text-xs font-semibold px-4 py-2 rounded-xl transition-all flex items-center gap-1.5 shadow-md flex-shrink-0 cursor-pointer">
                                        <span class="material-symbols-outlined text-sm">shopping_bag</span>
                                        <span>Ajouter</span>
                                    </button>
                                }
                                else
                                {
                                    <a asp-controller="Products" asp-action="Index" class="bg-white hover:bg-slate-100 text-slate-900 text-xs font-semibold px-4 py-2 rounded-xl transition-all flex items-center gap-1.5 shadow-md flex-shrink-0">
                                        <span>Découvrir</span>
                                        <span class="material-symbols-outlined text-sm">arrow_forward</span>
                                    </a>
                                }
                            </div>
                        </div>

                    </div>
                }
            </div>
        </section>
    }

    <!-- SECTION: NOS SOINS EN VIDÉO / STORIES GRANDES MARQUES -->
    @if (Model.StoryReels != null && Model.StoryReels.Any())
    {
        <section class="space-y-4 sm:space-y-6 md:-mx-6 lg:-mx-12 xl:-mx-20">
            <!-- Header -->
            <div class="flex items-center justify-between border-b border-slate-200/80 pb-3 gap-2 px-1">
                <div>
                    <div class="flex items-center gap-1.5 text-xs font-bold text-[#15803D] uppercase tracking-wider mb-0.5">
                        <span class="w-2 h-2 rounded-full bg-[#15803D] animate-pulse"></span>
                        <span>Démonstrations Rituels</span>
                    </div>
                    <h2 class="font-editorial text-xl sm:text-3xl md:text-4xl text-slate-900 font-bold tracking-tight">
                        Nos Soins en Démonstration
                    </h2>
                </div>
            </div>

            <!-- Story / Reel Cards: 1 Clean Full Card on Mobile with Swipe, Grand Wide-Screen 3-Column Grid on Desktop -->
            <div class="relative">
                <div id="storyReelsTrack" class="flex overflow-x-auto gap-4 pb-2 pt-1 hide-scrollbar snap-x snap-mandatory scroll-smooth w-full md:grid md:grid-cols-3 md:gap-6 lg:gap-8 md:pb-0">
                    @foreach (var story in Model.StoryReels)
                    {
                        <div class="reel-card group relative rounded-[24px] md:rounded-[32px] overflow-hidden bg-slate-950 text-white w-full max-w-[360px] mx-auto md:max-w-none md:w-full h-[460px] md:h-[540px] lg:h-[580px] shrink-0 snap-center shadow-[0_20px_45px_rgba(0,0,0,0.14)] border border-slate-800 flex flex-col justify-between p-5 md:p-7 transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_25px_55px_rgba(0,0,0,0.22)]">
                            
                            <!-- Autoplay Video Background (Continuous Loop) -->
                            <video autoplay muted loop playsinline preload="auto" onended="this.currentTime = 0; this.play();" poster="@story.PosterUrl" class="reel-video absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105">
                                <source src="@story.VideoUrl" type="video/mp4" />
                            </video>
                            <div class="absolute inset-0 z-0 bg-gradient-to-t from-black/50 via-transparent to-black/50 pointer-events-none"></div>

                            <!-- Top: Brand Badges & Sound Toggle -->
                            <div class="relative z-10 flex items-center justify-between">
                                <span class="text-xs font-semibold text-white bg-black/50 backdrop-blur-md px-3 py-1 rounded-lg">
                                    @story.BadgeText
                                </span>
                                
                                <!-- Sound Toggle / Control -->
                                <button type="button" onclick="toggleReelSound(this)" class="w-8 h-8 rounded-full bg-black/60 hover:bg-black/90 backdrop-blur-md border border-white/20 flex items-center justify-center transition-all cursor-pointer shadow-lg" title="Activer / Couper le son">
                                    <span class="material-symbols-outlined text-sm reel-sound-icon text-white">volume_off</span>
                                </button>
                            </div>

                            <!-- Center: Discrete Play/Pause Control on Click -->
                            <div class="relative z-10 flex flex-col items-center justify-center my-auto py-8">
                                <button type="button" onclick="toggleReelVideo(this)" class="w-14 h-14 rounded-full bg-black/40 hover:bg-black/70 text-white border border-white/30 flex items-center justify-center backdrop-blur-md transition-all duration-300 opacity-0 group-hover:opacity-100 hover:scale-110 cursor-pointer" aria-label="Pause / Reprendre">
                                    <span class="material-symbols-outlined text-2xl reel-play-icon">pause</span>
                                </button>
                            </div>

                            <!-- Bottom: Story Lab Name & Démonstration Soin only -->
                            <div class="relative z-10 bg-black/45 backdrop-blur-md px-4 py-3 rounded-2xl border border-white/10 mt-auto">
                                <div class="text-xs font-semibold text-amber-300">Laboratoire @story.BrandName</div>
                                <div class="text-xs text-slate-200">Démonstration Soin</div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Mobile Story Dots: 1 per reel, cleanly centered -->
                <div class="flex md:hidden items-center justify-center gap-1.5 pt-3" id="storyReelsDots">
                    @for (int i = 0; i < Model.StoryReels.Count; i++)
                    {
                        <span class="story-dot @(i == 0 ? "w-6 bg-[#15803D]" : "w-2 bg-slate-300") h-1.5 rounded-full transition-all duration-300"></span>
                    }
                </div>
            </div>
        </section>
    }
    <!-- Fast & Simple Ordering Banner (Desktop Only) -->
    <section class="relative rounded-3xl overflow-hidden bg-[#090D16] text-white p-8 md:p-14 border border-slate-800 shadow-2xl hidden md:block">
        <!-- Subtle Ambient Glow -->
        <div class="absolute -top-24 -right-24 w-72 h-72 bg-emerald-600/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-slate-700/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="max-w-2xl space-y-5 z-10 relative">
            <h2 class="font-editorial text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight leading-tight">
                Commandez en quelques clics, <span class="italic font-normal text-slate-200">sans formalités</span>
            </h2>
            <p class="text-sm text-slate-300 font-normal max-w-lg leading-relaxed">
                Aucun compte obligatoire : sélectionnez vos soins et confirmez directement vos achats en toute sérénité.
            </p>
            <div class="pt-2 flex flex-wrap items-center gap-3 sm:gap-4">
                <a asp-controller="Products" asp-action="Index" class="inline-flex items-center gap-2 bg-[#15803D] hover:bg-[#166534] text-white text-xs font-semibold px-7 py-3.5 rounded-xl transition-all shadow-lg hover:scale-[1.02]">
                    <span class="material-symbols-outlined text-base">shopping_bag</span> Commander Maintenant
                </a>
                <button type="button" onclick="openCartDrawer()" class="inline-flex items-center gap-2 bg-slate-800/90 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs font-semibold px-6 py-3.5 rounded-xl transition-all">
                    <span class="material-symbols-outlined text-base">shopping_cart</span> Mon Panier
                </button>
            </div>
            <div class="pt-2 flex flex-wrap items-center gap-4 sm:gap-6 text-xs text-slate-300">
                <span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-sm text-emerald-400">verified</span> 100% Officinal</span>
                <span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-sm text-emerald-400">schedule</span> Traitement Immédiat</span>
                <span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-sm text-emerald-400">payments</span> Paiement à la Livraison</span>
            </div>
        </div>
    </section>

    <!-- Trust Badges (Desktop Only) -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6 py-6 border-t border-slate-200 mt-8 hidden md:grid">
        <div class="flex items-center gap-4 p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover-lift group">
            <div class="w-12 h-12 rounded-full bg-slate-50 border border-slate-200 text-slate-900 flex items-center justify-center flex-shrink-0 group-hover:bg-black group-hover:text-white transition-all">
                <span class="material-symbols-outlined text-[24px]">verified</span>
            </div>
            <div>
                <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Origine Officinale</h4>
                <p class="text-[10px] text-slate-500 font-light mt-0.5 leading-relaxed">Produits 100% authentiques issus directement des laboratoires.</p>
            </div>
        </div>

        <div class="flex items-center gap-4 p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover-lift group">
            <div class="w-12 h-12 rounded-full bg-slate-50 border border-slate-200 text-slate-900 flex items-center justify-center flex-shrink-0 group-hover:bg-black group-hover:text-white transition-all">
                <span class="material-symbols-outlined text-[24px]">payments</span>
            </div>
            <div>
                <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Paiement à la Livraison</h4>
                <p class="text-[10px] text-slate-500 font-light mt-0.5 leading-relaxed">Réglez vos achats en toute confiance directement à la réception de votre colis.</p>
            </div>
        </div>

        <div class="flex items-center gap-4 p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover-lift group">
            <div class="w-12 h-12 rounded-full bg-slate-50 border border-slate-200 text-slate-900 flex items-center justify-center flex-shrink-0 group-hover:bg-black group-hover:text-white transition-all">
                <span class="material-symbols-outlined text-[24px]">local_pharmacy</span>
            </div>
            <div>
                <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Conseil Pharmacien</h4>
                <p class="text-[10px] text-slate-500 font-light mt-0.5 leading-relaxed">Équipe d'experts disponibles en permanence.</p>
            </div>
        </div>
    </section>
</main>
