@model PharmaTrust.Controllers.AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tableau de Bord";
}

<div class="space-y-6 sm:space-y-8">
    <!-- Welcome Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="font-editorial text-2xl sm:text-3xl font-bold text-slate-900">Tableau de Bord Officinal</h1>
            <p class="text-xs text-slate-500 mt-1">Supervision de votre catalogue de soins, stocks et flux de commandes en temps réel.</p>
        </div>
        <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
            <a asp-controller="Admin" asp-action="Stock" class="flex-1 sm:flex-initial bg-black hover:bg-slate-800 text-white text-xs font-bold uppercase tracking-wider px-3.5 sm:px-4 py-2.5 rounded-xl transition-all flex items-center justify-center gap-1.5 sm:gap-2 shadow-sm">
                <span class="material-symbols-outlined text-sm">shelves</span>
                <span>Stocks</span>
            </a>
            <a asp-controller="Admin" asp-action="CreateProduct" class="flex-1 sm:flex-initial bg-white border border-slate-200 text-slate-800 hover:bg-slate-50 text-xs font-bold uppercase tracking-wider px-3.5 sm:px-4 py-2.5 rounded-xl transition-all shadow-sm flex items-center justify-center gap-1.5">
                <span class="material-symbols-outlined text-sm">add</span>
                <span>Nouveau Soin</span>
            </a>
            <a asp-controller="Admin" asp-action="Orders" class="w-full sm:w-auto bg-white border border-slate-200 text-slate-800 hover:bg-slate-50 text-xs font-bold uppercase tracking-wider px-3.5 sm:px-4 py-2.5 rounded-xl transition-all shadow-sm flex items-center justify-center gap-1.5">
                <span class="material-symbols-outlined text-sm text-emerald-600">local_shipping</span>
                <span>Commandes (@Model.TotalOrdersCount)</span>
            </a>
        </div>
    </div>

    <!-- Stats KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        <div class="bg-white p-5 sm:p-6 rounded-2xl sm:rounded-3xl border @(Model.LowStockProductsCount > 0 || Model.OutOfStockProducts > 0 ? "border-amber-300 bg-amber-50/20" : "border-slate-200") shadow-sm flex items-center justify-between">
            <div>
                <div class="text-[10px] sm:text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-1">Stocks Critiques</div>
                <div class="text-2xl sm:text-3xl font-bold @(Model.OutOfStockProducts > 0 ? "text-red-600" : Model.LowStockProductsCount > 0 ? "text-amber-600" : "text-slate-900")">
                    @(Model.LowStockProductsCount + Model.OutOfStockProducts)
                </div>
                <div class="text-[10.5px] sm:text-[11px] text-slate-500 mt-1 flex items-center gap-1.5 flex-wrap">
                    <span class="text-red-600 font-bold">@Model.OutOfStockProducts rupture(s)</span> &bull; 
                    <span class="text-amber-700 font-semibold">@Model.LowStockProductsCount faible(s)</span>
                </div>
            </div>
            <a asp-controller="Admin" asp-action="Stock" class="w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-700 hover:bg-amber-100 transition-colors shrink-0">
                <span class="material-symbols-outlined text-xl sm:text-2xl">notification_important</span>
            </a>
        </div>

        <div class="bg-white p-5 sm:p-6 rounded-2xl sm:rounded-3xl border border-slate-200 shadow-sm flex items-center justify-between">
            <div>
                <div class="text-[10px] sm:text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-1">Commandes Clients</div>
                <div class="text-2xl sm:text-3xl font-bold text-slate-900">@Model.TotalOrdersCount</div>
                <div class="text-[10.5px] sm:text-[11px] text-slate-500 mt-1">Commandes enregistrées</div>
            </div>
            <a asp-controller="Admin" asp-action="Orders" class="w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-slate-100 flex items-center justify-center text-slate-900 hover:bg-slate-200 transition-colors shrink-0">
                <span class="material-symbols-outlined text-xl sm:text-2xl">shopping_cart_checkout</span>
            </a>
        </div>
    </div>

    <!-- Quick Navigation Shortcuts on Phone -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <a asp-controller="Admin" asp-action="Products" class="bg-white border border-slate-200 rounded-2xl p-4 text-center hover:border-black hover:shadow-md transition-all group">
            <span class="material-symbols-outlined text-2xl text-slate-700 group-hover:text-black mb-1">inventory_2</span>
            <span class="block text-xs font-bold text-slate-900">Produits</span>
            <span class="text-[10px] text-slate-400 font-medium">Catalogue</span>
        </a>
        <a asp-controller="Admin" asp-action="Stock" class="bg-white border border-slate-200 rounded-2xl p-4 text-center hover:border-black hover:shadow-md transition-all group">
            <span class="material-symbols-outlined text-2xl text-emerald-600 group-hover:text-emerald-700 mb-1">shelves</span>
            <span class="block text-xs font-bold text-slate-900">Stocks</span>
            <span class="text-[10px] text-slate-400 font-medium">Réapprovisionner</span>
        </a>
        <a asp-controller="Admin" asp-action="Categories" class="bg-white border border-slate-200 rounded-2xl p-4 text-center hover:border-black hover:shadow-md transition-all group">
            <span class="material-symbols-outlined text-2xl text-slate-700 group-hover:text-black mb-1">category</span>
            <span class="block text-xs font-bold text-slate-900">Catégories</span>
            <span class="text-[10px] text-slate-400 font-medium">Rayons &amp; Icônes</span>
        </a>
        <a asp-controller="Admin" asp-action="Brands" class="bg-white border border-slate-200 rounded-2xl p-4 text-center hover:border-black hover:shadow-md transition-all group">
            <span class="material-symbols-outlined text-2xl text-slate-700 group-hover:text-black mb-1">verified</span>
            <span class="block text-xs font-bold text-slate-900">Marques</span>
            <span class="text-[10px] text-slate-400 font-medium">Laboratoires</span>
        </a>
    </div>

    <!-- Recent Orders Section -->
    <div class="bg-white border border-slate-200 rounded-3xl p-5 sm:p-6 shadow-sm space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3 sm:pb-4">
            <div>
                <h3 class="font-editorial text-base sm:text-lg font-bold text-slate-900">Dernières Commandes</h3>
                <p class="text-[11px] sm:text-xs text-slate-400">Flux d'achats récents</p>
            </div>
            <a asp-controller="Admin" asp-action="Orders" class="text-xs font-bold uppercase tracking-wider text-black hover:underline flex items-center gap-1">
                <span>Voir Tout</span>
                <span class="material-symbols-outlined text-xs">arrow_forward</span>
            </a>
        </div>

        <div class="space-y-2.5 sm:space-y-3">
            @if (Model.RecentOrders.Any())
            {
                @foreach (var ord in Model.RecentOrders)
                {
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between p-3.5 rounded-2xl bg-slate-50 border border-slate-100 text-xs hover:border-slate-300 transition-all gap-2">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-slate-900 font-mono">@ord.OrderNumber</span>
                                <span class="text-[9px] font-bold px-2 py-0.5 rounded-full sm:hidden @(ord.Status == "Livrée" ? "bg-emerald-50 text-emerald-800" : ord.Status == "Annulée" ? "bg-red-50 text-red-800" : "bg-amber-50 text-amber-800")">
                                    @ord.Status
                                </span>
                            </div>
                            <div class="text-[11px] text-slate-500 mt-0.5">@ord.CustomerName &bull; @ord.City</div>
                        </div>
                        <div class="flex items-center justify-between sm:text-right sm:block">
                            <div class="font-bold text-slate-900 text-sm sm:text-xs">@ord.TotalAmount.ToString("F2") DT</div>
                            <span class="hidden sm:inline-block text-[9.5px] font-bold px-2 py-0.5 rounded-full @(ord.Status == "Livrée" ? "bg-emerald-50 text-emerald-800" : ord.Status == "Annulée" ? "bg-red-50 text-red-800" : "bg-amber-50 text-amber-800")">
                                @ord.Status
                            </span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="py-8 text-center text-slate-400 text-xs">Aucune commande enregistrée.</div>
            }
        </div>
    </div>
</div>
