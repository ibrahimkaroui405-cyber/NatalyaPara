@model List<PharmaTrust.Models.Order>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Commandes & Expéditions";
    string searchQuery = ViewBag.SearchQuery as string ?? "";
    string selectedStatus = ViewBag.SelectedStatus as string ?? "";

    int currentPage = ViewBag.CurrentPage as int? ?? 1;
    int pageSize = ViewBag.PageSize as int? ?? 10;
    int totalCount = ViewBag.FilteredCount as int? ?? Model.Count;
    int totalPages = ViewBag.TotalPages as int? ?? 1;
    bool hasPreviousPage = ViewBag.HasPreviousPage as bool? ?? false;
    bool hasNextPage = ViewBag.HasNextPage as bool? ?? false;
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-4">
        <div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 text-slate-800 text-[10px] font-bold uppercase tracking-wider mb-2 border border-slate-200">
                <span class="material-symbols-outlined text-xs text-[#15803D]">local_shipping</span>
                <span>Flux de Commandes Officinales</span>
            </div>
            <h1 class="font-editorial text-2xl sm:text-3xl font-bold text-slate-900">Suivi des Commandes (@totalCount)</h1>
            <p class="text-xs text-slate-500 mt-1">Consultez les commandes en direct, mettez à jour les statuts et gérez les alertes Telegram & WhatsApp.</p>
        </div>
        <div class="flex items-center gap-2">
            <button type="button" onclick="document.getElementById('notifSettingsModal').classList.toggle('hidden')" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold uppercase tracking-wider px-4 py-2.5 rounded-xl transition-all flex items-center justify-center gap-2 shadow-sm">
                <span class="material-symbols-outlined text-sm">notifications_active</span>
                <span>Alertes Telegram (@(ViewBag.TelegramSettings?.IsEnabled == true && !string.IsNullOrEmpty(ViewBag.TelegramSettings?.BotToken) ? "Actif" : "Config"))</span>
            </button>
            <a asp-controller="Admin" asp-action="Stock" class="bg-black hover:bg-slate-800 text-white text-xs font-bold uppercase tracking-wider px-4 sm:px-5 py-2.5 rounded-xl transition-all flex items-center justify-center gap-2 shadow-sm self-start sm:self-auto w-full sm:w-auto">
                <span class="material-symbols-outlined text-sm">shelves</span>
                <span>Gestion des Stocks</span>
            </a>
        </div>
    </div>

    <!-- Telegram & WhatsApp Settings Card -->
    @{
        var teleSettings = ViewBag.TelegramSettings as PharmaTrust.Models.TelegramSettings ?? new PharmaTrust.Models.TelegramSettings();
        bool isConfigured = !string.IsNullOrWhiteSpace(teleSettings.BotToken) && !string.IsNullOrWhiteSpace(teleSettings.ChatId);
    }
    <div id="notifSettingsModal" class="@(isConfigured ? "hidden" : "") bg-gradient-to-br from-slate-900 to-slate-950 text-white p-5 sm:p-6 rounded-3xl shadow-xl border border-slate-800 transition-all">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-800 pb-4 mb-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-[#0088cc] flex items-center justify-center text-white shadow-lg">
                    <span class="material-symbols-outlined text-xl">send</span>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-white flex items-center gap-2">
                        <span>Alertes Instantanées Telegram &amp; WhatsApp</span>
                        <span class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-full @(isConfigured ? "bg-emerald-950/80 text-emerald-400 border border-emerald-800" : "bg-amber-950/80 text-amber-300 border border-amber-800")">
                            <span class="w-1.5 h-1.5 rounded-full @(isConfigured ? "bg-emerald-400" : "bg-amber-400") animate-pulse"></span>
                            @(isConfigured ? "Actif & Connecté" : "En attente de configuration")
                        </span>
                    </h3>
                    <p class="text-[11px] text-slate-400">Recevez un PING sonore immédiat sur votre smartphone avec tous les détails de chaque commande passée sur Natalya Para.</p>
                </div>
            </div>
            <button type="button" onclick="document.getElementById('notifSettingsModal').classList.add('hidden')" class="text-slate-400 hover:text-white text-xs px-2.5 py-1 rounded-lg hover:bg-slate-800 self-end sm:self-auto">
                Masquer
            </button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            <!-- How-To Guide in 2 steps -->
            <div class="lg:col-span-5 bg-slate-800/60 p-4 rounded-2xl border border-slate-700/60 text-xs space-y-2.5">
                <div class="font-bold text-emerald-400 flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-sm">tips_and_updates</span>
                    <span>Comment activer en 1 minute (Gratuit) :</span>
                </div>
                <ol class="list-decimal list-inside space-y-2 text-slate-300 text-[11px] leading-relaxed">
                    <li>Ouvrez <b>Telegram</b> sur votre téléphone et cherchez <b>@@BotFather</b>. Envoyez <code>/newbot</code>, choisissez un nom, et copiez le <b>Bot Token</b>.</li>
                    <li>Cherchez <b>@@userinfobot</b> sur Telegram et envoyez un message pour obtenir votre <b>Chat ID</b> numérique (ex: <i>123456789</i>).</li>
                    <li>Envoyez <code>/start</code> à votre nouveau bot, collez vos identifiants ci-contre et cliquez sur <b>Tester</b> !</li>
                </ol>
                <div class="pt-1 text-[10px] text-slate-400 border-t border-slate-700/50">
                    💡 WhatsApp est déjà lié à votre numéro : <b class="text-white">+216 21 040 266</b>.
                </div>
            </div>

            <!-- Configuration Form -->
            <div class="lg:col-span-7 space-y-3">
                <form asp-controller="Admin" asp-action="SaveNotificationSettings" method="post" class="space-y-3">
                    @Html.AntiForgeryToken()
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[11px] font-semibold text-slate-300 mb-1">Telegram Bot Token</label>
                            <input type="text" name="botToken" value="@teleSettings.BotToken" placeholder="ex: 7891234567:AAHxyz..." class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 font-mono" />
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-slate-300 mb-1">Votre Telegram Chat ID</label>
                            <input type="text" name="chatId" value="@teleSettings.ChatId" placeholder="ex: 123456789" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 font-mono" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 items-center">
                        <div>
                            <label class="block text-[11px] font-semibold text-slate-300 mb-1">WhatsApp Pharmacie</label>
                            <input type="text" name="ownerWhatsApp" value="@teleSettings.OwnerWhatsApp" placeholder="21621040266" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 font-mono" />
                        </div>
                        <div class="pt-5 flex items-center gap-2">
                            <label class="inline-flex items-center gap-2 cursor-pointer text-xs text-slate-300">
                                <input type="checkbox" name="isEnabled" value="true" checked="@teleSettings.IsEnabled" class="w-4 h-4 rounded text-emerald-600 focus:ring-0 bg-slate-800 border-slate-700" />
                                <span>Activer les notifications automatiques</span>
                            </label>
                        </div>
                    </div>

                    <div class="flex items-center gap-2 pt-2">
                        <button type="submit" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-bold uppercase tracking-wider transition-all shadow-md">
                            Sauvegarder
                        </button>
                    </div>
                </form>

                <!-- Test button -->
                <form asp-controller="Admin" asp-action="TestTelegram" method="post" class="inline-block pt-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="botToken" value="@teleSettings.BotToken" />
                    <input type="hidden" name="chatId" value="@teleSettings.ChatId" />
                    <button type="submit" class="px-3.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-cyan-300 text-[11px] font-semibold rounded-xl border border-slate-700 transition-colors flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-xs">send</span>
                        <span>Envoyer un message test sur mon téléphone</span>
                    </button>
                </form>

                @if (!string.IsNullOrEmpty(teleSettings.LastNotificationStatus))
                {
                    <div class="text-[10px] text-slate-400 mt-1">
                        Dernier statut : <span class="text-slate-300 font-mono">@teleSettings.LastNotificationStatus</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Orders Filter & Search Bar -->
    <div class="bg-white p-3.5 sm:p-4 rounded-2xl sm:rounded-3xl border border-slate-200 shadow-sm space-y-3">
        <form asp-controller="Admin" asp-action="Orders" method="get" class="grid grid-cols-1 sm:grid-cols-12 gap-2.5 sm:gap-3 items-center">
            <div class="relative sm:col-span-6">
                <input type="text" name="q" value="@searchQuery" placeholder="N° commande, client, ville, tél..." class="w-full py-2.5 pl-9 pr-4 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 placeholder-slate-400 text-xs focus:outline-none focus:border-black" />
                <span class="material-symbols-outlined text-slate-400 text-sm absolute left-3 top-3">search</span>
            </div>

            <div class="sm:col-span-4">
                <select name="status" onchange="this.form.submit()" class="w-full py-2.5 px-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-800 text-xs focus:outline-none focus:border-black cursor-pointer truncate">
                    <option value="">Tous les statuts</option>
                    <option value="En attente" selected="@(selectedStatus == "En attente")">En attente</option>
                    <option value="En préparation" selected="@(selectedStatus == "En préparation")">En préparation</option>
                    <option value="Expédiée" selected="@(selectedStatus == "Expédiée")">Expédiée</option>
                    <option value="Livrée" selected="@(selectedStatus == "Livrée")">Livrée</option>
                    <option value="Annulée" selected="@(selectedStatus == "Annulée")">Annulée (Stock restitué)</option>
                </select>
            </div>

            <div class="sm:col-span-2">
                <button type="submit" class="w-full py-2.5 bg-black text-white rounded-xl text-xs font-bold uppercase tracking-wider hover:bg-slate-800 transition-all text-center">
                    Filtrer
                </button>
            </div>
        </form>

        @if (!string.IsNullOrEmpty(searchQuery) || !string.IsNullOrEmpty(selectedStatus))
        {
            <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs">
                <span class="text-slate-500 text-[11px]">Filtre actif</span>
                <a asp-controller="Admin" asp-action="Orders" class="text-xs text-slate-700 hover:text-black flex items-center gap-1 font-semibold">
                    <span class="material-symbols-outlined text-sm">close</span> Effacer les filtres
                </a>
            </div>
        }
    </div>

    <!-- Mobile Orders Cards View (< md) -->
    <div class="md:hidden space-y-3.5">
        @if (Model.Any())
        {
            @foreach (var order in Model)
            {
                <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm space-y-3">
                    <!-- Top Order Info & Status -->
                    <div class="flex items-start justify-between gap-2 border-b border-slate-100 pb-2.5">
                        <div>
                            <div class="font-mono font-bold text-slate-900 text-sm">@order.OrderNumber</div>
                            <div class="text-[10px] text-slate-400">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <div>
                            @if (order.Status == "Livrée")
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 text-[10px] font-bold border border-emerald-200">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> Livrée
                                </span>
                            }
                            else if (order.Status == "Expédiée")
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-800 text-[10px] font-bold border border-blue-200">
                                    <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span> Expédiée
                                </span>
                            }
                            else if (order.Status == "En préparation")
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-800 text-[10px] font-bold border border-amber-200">
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span> En prép.
                                </span>
                            }
                            else if (order.Status == "Annulée")
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-red-50 text-red-800 text-[10px] font-bold border border-red-200">
                                    <span class="w-1.5 h-1.5 rounded-full bg-red-600"></span> Annulée
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-800 text-[10px] font-bold border border-slate-200">
                                    <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span> @order.Status
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Customer details -->
                    <div class="space-y-1 text-xs">
                        <div class="font-bold text-slate-900">@order.CustomerName</div>
                        <div class="flex items-center gap-2 text-slate-600">
                            <a href="tel:@order.Phone" class="inline-flex items-center gap-1 text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded-lg border border-emerald-200 hover:bg-emerald-100">
                                <span class="material-symbols-outlined text-xs">call</span> @order.Phone
                            </a>
                            <a href="https://wa.me/216@(order.Phone.Replace(" ", "").Replace("+216", "").Trim())" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[#25D366] font-bold bg-green-50 px-2 py-0.5 rounded-lg border border-green-200 hover:bg-green-100" title="Contacter le client sur WhatsApp">
                                <svg class="w-3 h-3 fill-[#25D366]" viewBox="0 0 24 24"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 1.67c2.2 0 4.26.86 5.82 2.42a8.182 8.182 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.42 0-2.82-.37-4.06-1.08l-.29-.17-3.12.82.83-3.04-.19-.3a8.216 8.216 0 0 1-1.26-4.46c0-4.54 3.7-8.24 8.24-8.24zm4.8 11.53c-.26-.13-1.54-.76-1.78-.85-.24-.09-.41-.13-.58.13-.17.26-.68.85-.83 1.02-.15.17-.31.19-.57.06-.26-.13-1.1-.41-2.09-1.3-.77-.69-1.29-1.54-1.44-1.8-.15-.26-.02-.4.11-.53.12-.11.26-.31.39-.46.13-.15.17-.26.26-.43.09-.17.04-.32-.02-.45-.07-.13-.58-1.4-.79-1.92-.21-.51-.42-.44-.58-.45l-.49-.01c-.17 0-.45.06-.69.32-.24.26-.91.89-.91 2.17 0 1.28.93 2.52 1.06 2.69.13.17 1.84 2.81 4.46 3.94.62.27 1.11.43 1.49.55.63.2 1.2.17 1.65.1.5-.07 1.54-.63 1.76-1.24.22-.61.22-1.13.15-1.24-.07-.11-.24-.17-.5-.3z"/></svg>
                                <span>WA</span>
                            </a>
                            <span class="text-[11px] text-slate-500 truncate">@order.City</span>
                        </div>
                        <div class="text-[11px] text-slate-400">@order.Address</div>
                    </div>

                    <!-- Items ordered preview -->
                    <div class="bg-slate-50 rounded-xl p-2.5 space-y-1.5 border border-slate-100">
                        @foreach (var item in order.Items)
                        {
                            <div class="flex items-center gap-2 text-[11px]">
                                <img src="@item.ImageUrl" alt="@item.ProductName" class="w-6 h-6 rounded-md object-cover border border-slate-200 shrink-0" onerror="this.src='https://placehold.co/50x50?text=Item'" />
                                <div class="truncate flex-1">
                                    <span class="font-bold text-slate-900">x@(item.Quantity)</span> @item.ProductName
                                </div>
                                <span class="font-semibold text-slate-700 shrink-0">@((item.UnitPrice * item.Quantity).ToString("F2")) DT</span>
                            </div>
                        }
                    </div>

                    <!-- Total & Status Change -->
                    <div class="flex items-center justify-between pt-2 border-t border-slate-100">
                        <div>
                            <span class="text-[10px] text-slate-400 block uppercase font-semibold">Total TTC</span>
                            <span class="font-bold text-slate-900 text-base">@order.TotalAmount.ToString("F2") DT</span>
                        </div>

                        <form asp-controller="Admin" asp-action="UpdateOrderStatus" method="post" class="inline-flex items-center gap-1">
                            <input type="hidden" name="orderNumber" value="@order.OrderNumber" />
                            <select name="status" onchange="this.form.submit()" class="py-1.5 px-3 rounded-xl border border-slate-200 bg-slate-50 text-xs font-bold text-slate-800 focus:outline-none focus:border-black cursor-pointer shadow-2xs">
                                <option value="En attente" selected="@(order.Status == "En attente")">En attente</option>
                                <option value="En préparation" selected="@(order.Status == "En préparation")">En préparation</option>
                                <option value="Expédiée" selected="@(order.Status == "Expédiée")">Expédiée</option>
                                <option value="Livrée" selected="@(order.Status == "Livrée")">Livrée</option>
                                <option value="Annulée" selected="@(order.Status == "Annulée")">Annulée (Restituer)</option>
                            </select>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="bg-white border border-slate-200 rounded-2xl p-8 text-center text-slate-400 text-xs">
                Aucune commande trouvée pour ces critères.
            </div>
        }
    </div>

    <!-- Desktop Orders Table (>= md) -->
    <div class="hidden md:block bg-white border border-slate-200 rounded-3xl overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead>
                    <tr class="bg-slate-50/80 text-slate-400 uppercase tracking-wider border-b border-slate-200">
                        <th class="py-3.5 px-6 font-semibold">N° Commande</th>
                        <th class="py-3.5 px-6 font-semibold">Client &amp; Contact</th>
                        <th class="py-3.5 px-6 font-semibold">Date</th>
                        <th class="py-3.5 px-6 font-semibold">Articles Commandés</th>
                        <th class="py-3.5 px-6 font-semibold">Total TTC</th>
                        <th class="py-3.5 px-6 font-semibold">Statut Commande</th>
                        <th class="py-3.5 px-6 font-semibold text-right">Action Statut</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model.Any())
                    {
                        @foreach (var order in Model)
                        {
                            <tr class="hover:bg-slate-50/70 transition-colors">
                                <td class="py-4 px-6">
                                    <div class="font-mono font-bold text-slate-900 text-[13px]">@order.OrderNumber</div>
                                    <span class="text-[10px] text-slate-400 block mt-0.5">Espèces à la livraison</span>
                                </td>
                                <td class="py-4 px-6">
                                    <div class="font-bold text-slate-900">@order.CustomerName</div>
                                    <div class="text-[11px] text-slate-500 flex items-center gap-1 mt-0.5">
                                        <span class="material-symbols-outlined text-xs">call</span> @order.Phone
                                    </div>
                                    <div class="text-[10px] text-slate-400 mt-0.5">@order.City - @order.Address</div>
                                </td>
                                <td class="py-4 px-6 text-slate-500 whitespace-nowrap">
                                    @order.OrderDate.ToString("dd/MM/yyyy")
                                    <span class="text-[10px] text-slate-400 block">@order.OrderDate.ToString("HH:mm")</span>
                                </td>
                                <td class="py-4 px-6">
                                    <div class="space-y-1.5 max-w-xs">
                                        @foreach (var item in order.Items)
                                        {
                                            <div class="flex items-center gap-2">
                                                <img src="@item.ImageUrl" alt="@item.ProductName" class="w-6 h-6 rounded-md object-cover border border-slate-200" onerror="this.src='https://placehold.co/50x50?text=Item'" />
                                                <div class="truncate text-[11px]">
                                                    <span class="font-bold text-slate-800">x@(item.Quantity)</span> @item.ProductName
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td class="py-4 px-6 font-bold text-slate-900 text-sm whitespace-nowrap">
                                    @order.TotalAmount.ToString("F2") DT
                                </td>
                                <td class="py-4 px-6 whitespace-nowrap">
                                    @if (order.Status == "Livrée")
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-[10px] font-bold border border-emerald-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> Livrée
                                        </span>
                                    }
                                    else if (order.Status == "Expédiée")
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-50 text-blue-800 text-[10px] font-bold border border-blue-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span> Expédiée
                                        </span>
                                    }
                                    else if (order.Status == "En préparation")
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-50 text-amber-800 text-[10px] font-bold border border-amber-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span> En préparation
                                        </span>
                                    }
                                    else if (order.Status == "Annulée")
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-50 text-red-800 text-[10px] font-bold border border-red-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-red-600"></span> Annulée (Restitué)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 text-slate-800 text-[10px] font-bold border border-slate-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span> @order.Status
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-6 text-right whitespace-nowrap">
                                    <div class="inline-flex items-center gap-2">
                                        <a href="https://wa.me/216@(order.Phone.Replace(" ", "").Replace("+216", "").Trim())" target="_blank" rel="noopener noreferrer" class="p-1.5 rounded-xl bg-green-50 text-[#25D366] hover:bg-green-100 border border-green-200 transition-colors inline-flex items-center justify-center shadow-2xs" title="Contacter le client sur WhatsApp (@order.Phone)">
                                            <svg class="w-3.5 h-3.5 fill-[#25D366]" viewBox="0 0 24 24"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 1.67c2.2 0 4.26.86 5.82 2.42a8.182 8.182 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.42 0-2.82-.37-4.06-1.08l-.29-.17-3.12.82.83-3.04-.19-.3a8.216 8.216 0 0 1-1.26-4.46c0-4.54 3.7-8.24 8.24-8.24zm4.8 11.53c-.26-.13-1.54-.76-1.78-.85-.24-.09-.41-.13-.58.13-.17.26-.68.85-.83 1.02-.15.17-.31.19-.57.06-.26-.13-1.1-.41-2.09-1.3-.77-.69-1.29-1.54-1.44-1.8-.15-.26-.02-.4.11-.53.12-.11.26-.31.39-.46.13-.15.17-.26.26-.43.09-.17.04-.32-.02-.45-.07-.13-.58-1.4-.79-1.92-.21-.51-.42-.44-.58-.45l-.49-.01c-.17 0-.45.06-.69.32-.24.26-.91.89-.91 2.17 0 1.28.93 2.52 1.06 2.69.13.17 1.84 2.81 4.46 3.94.62.27 1.11.43 1.49.55.63.2 1.2.17 1.65.1.5-.07 1.54-.63 1.76-1.24.22-.61.22-1.13.15-1.24-.07-.11-.24-.17-.5-.3z"/></svg>
                                        </a>
                                        <form asp-controller="Admin" asp-action="UpdateOrderStatus" method="post" class="inline-flex items-center gap-1">
                                            <input type="hidden" name="orderNumber" value="@order.OrderNumber" />
                                            <select name="status" onchange="this.form.submit()" class="py-1 px-2.5 rounded-xl border border-slate-200 bg-slate-50 text-[11px] font-semibold text-slate-800 focus:outline-none focus:border-black cursor-pointer">
                                                <option value="En attente" selected="@(order.Status == "En attente")">En attente</option>
                                                <option value="En préparation" selected="@(order.Status == "En préparation")">En préparation</option>
                                                <option value="Expédiée" selected="@(order.Status == "Expédiée")">Expédiée</option>
                                                <option value="Livrée" selected="@(order.Status == "Livrée")">Livrée</option>
                                                <option value="Annulée" selected="@(order.Status == "Annulée")">Annulée (Restituer stock)</option>
                                            </select>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-slate-400">
                                Aucune commande trouvée pour ces critères.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <!-- Orders Pagination Bar -->
        <div class="p-4 sm:p-5 rounded-2xl sm:rounded-3xl border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 bg-white shadow-sm">
            <div class="text-xs text-slate-500 font-medium text-center sm:text-left">
                Affichage de <strong class="text-slate-900 font-bold">@((currentPage - 1) * pageSize + 1)</strong> à 
                <strong class="text-slate-900 font-bold">@(Math.Min(currentPage * pageSize, totalCount))</strong> sur 
                <strong class="text-slate-900 font-bold">@totalCount</strong> commandes
            </div>

            <div class="flex items-center gap-1.5 flex-wrap justify-center">
                <!-- Prev -->
                @if (hasPreviousPage)
                {
                    <a asp-controller="Admin" asp-action="Orders" 
                       asp-route-page="@(currentPage - 1)" 
                       asp-route-q="@searchQuery" 
                       asp-route-status="@selectedStatus"
                       class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold transition-all shadow-2xs">
                        <span class="material-symbols-outlined text-sm">chevron_left</span>
                        <span class="hidden sm:inline">Précédent</span>
                    </a>
                }
                else
                {
                    <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl border border-slate-100 bg-slate-100/60 text-slate-300 text-xs font-bold cursor-not-allowed select-none">
                        <span class="material-symbols-outlined text-sm">chevron_left</span>
                        <span class="hidden sm:inline">Précédent</span>
                    </span>
                }

                <!-- Page Numbers -->
                @for (int i = 1; i <= totalPages; i++)
                {
                    var isCur = i == currentPage;
                    if (i == 1 || i == totalPages || (i >= currentPage - 1 && i <= currentPage + 1))
                    {
                        <a asp-controller="Admin" asp-action="Orders" 
                           asp-route-page="@i" 
                           asp-route-q="@searchQuery" 
                           asp-route-status="@selectedStatus"
                           class="w-8 h-8 flex items-center justify-center rounded-xl text-xs font-bold transition-all shadow-2xs @(isCur ? "bg-black text-white shadow-sm" : "bg-white text-slate-700 border border-slate-200 hover:bg-slate-100")">
                            @i
                        </a>
                    }
                    else if (i == currentPage - 2 || i == currentPage + 2)
                    {
                        <span class="w-7 h-7 flex items-center justify-center text-slate-400 font-bold text-xs select-none">&hellip;</span>
                    }
                }

                <!-- Next -->
                @if (hasNextPage)
                {
                    <a asp-controller="Admin" asp-action="Orders" 
                       asp-route-page="@(currentPage + 1)" 
                       asp-route-q="@searchQuery" 
                       asp-route-status="@selectedStatus"
                       class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold transition-all shadow-2xs">
                        <span class="hidden sm:inline">Suivant</span>
                        <span class="material-symbols-outlined text-sm">chevron_right</span>
                    </a>
                }
                else
                {
                    <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl border border-slate-100 bg-slate-100/60 text-slate-300 text-xs font-bold cursor-not-allowed select-none">
                        <span class="hidden sm:inline">Suivant</span>
                        <span class="material-symbols-outlined text-sm">chevron_right</span>
                    </span>
                }
            </div>
        </div>
    }
</div>
