@model List<PharmaTrust.Models.DeliveryRegion>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Frais de Livraison par Région - Natalya Admin";
    var activeCount = Model.Count(r => r.IsActive);
    var avgFee = Model.Any() ? Model.Average(r => r.DeliveryFee) : 7.00m;
    var minFee = Model.Any() ? Model.Min(r => r.DeliveryFee) : 6.00m;
    var maxFee = Model.Any() ? Model.Max(r => r.DeliveryFee) : 9.00m;
}

<div class="space-y-6 sm:space-y-8 max-w-6xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-5">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-800 text-[11px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full border border-emerald-200">
                    <span class="material-symbols-outlined text-xs">local_shipping</span> 24 Régions de Tunisie
                </span>
            </div>
            <h1 class="font-editorial text-2xl sm:text-3xl font-bold text-slate-900">
                Frais de Livraison &amp; Gouvernorats
            </h1>
            <p class="text-xs text-slate-500 mt-1">
                Configurez les tarifs d'expédition appliqués automatiquement dans le panier et le récapitulatif client lors du choix de la ville.
            </p>
        </div>

        <div class="flex items-center gap-2">
            <span class="text-xs text-slate-500 bg-white px-3 py-2 rounded-xl border border-slate-200 shadow-xs flex items-center gap-1.5 font-medium">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                @activeCount / 24 gouvernorats actifs
            </span>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
        <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-2xs">
            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Gouvernorats</div>
            <div class="text-xl sm:text-2xl font-extrabold text-slate-900 font-editorial">24</div>
            <div class="text-[11px] text-emerald-600 font-semibold mt-1">Couverture intégrale</div>
        </div>
        <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-2xs">
            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Tarif Moyen</div>
            <div class="text-xl sm:text-2xl font-extrabold text-slate-900 font-editorial">@avgFee.ToString("F2") DT</div>
            <div class="text-[11px] text-slate-500 mt-1">Par expédition</div>
        </div>
        <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-2xs">
            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Tarif Minimum</div>
            <div class="text-xl sm:text-2xl font-extrabold text-emerald-700 font-editorial">@minFee.ToString("F2") DT</div>
            <div class="text-[11px] text-slate-500 mt-1">Zones de proximité</div>
        </div>
        <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-2xs">
            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Tarif Maximum</div>
            <div class="text-xl sm:text-2xl font-extrabold text-slate-800 font-editorial">@maxFee.ToString("F2") DT</div>
            <div class="text-[11px] text-slate-500 mt-1">Régions éloignées / Sud</div>
        </div>
    </div>

    <!-- Filter / Search Box -->
    <div class="bg-white border border-slate-200 rounded-2xl p-3 sm:p-4 shadow-2xs flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
        <div class="relative flex-1">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
            <input type="text" id="regionSearchInput" placeholder="Rechercher un gouvernorat (ex: Tunis, Sousse, Sfax, Tataouine...)" 
                   class="w-full pl-9 pr-4 py-2 border border-slate-200 rounded-xl text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-slate-50 focus:bg-white transition-all" />
        </div>
        <div class="flex items-center gap-2">
            <button type="button" onclick="filterRegions('all')" class="region-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-900 text-white transition-all">Tous (24)</button>
            <button type="button" onclick="filterRegions('active')" class="region-filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 transition-all">Actifs</button>
        </div>
    </div>

    <!-- Regions Grid / Table -->
    <div class="bg-white border border-slate-200 rounded-3xl shadow-sm overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-slate-100 flex items-center justify-between">
            <h3 class="font-bold text-slate-900 text-sm sm:text-base flex items-center gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-lg">pin_drop</span>
                Grille Tarifaire des 24 Gouvernorats
            </h3>
            <span class="text-[11px] text-slate-400">Cliquez sur « Enregistrer » pour appliquer un tarif</span>
        </div>

        <div class="divide-y divide-slate-100">
            @foreach (var region in Model)
            {
                <div class="region-item p-4 sm:p-5 hover:bg-slate-50/60 transition-colors flex flex-col lg:flex-row lg:items-center justify-between gap-4" data-name="@region.Name.ToLowerInvariant()" data-active="@region.IsActive.ToString().ToLowerInvariant()">
                    <!-- Left: Region Name & Badge -->
                    <div class="flex items-center gap-3.5 min-w-[220px]">
                        <div class="w-10 h-10 rounded-xl @(region.IsActive ? "bg-emerald-50 text-emerald-700 border-emerald-200" : "bg-slate-100 text-slate-400 border-slate-200") border flex items-center justify-center font-bold text-sm shrink-0">
                            <span class="material-symbols-outlined text-xl">location_on</span>
                        </div>
                        <div>
                            <div class="font-bold text-slate-900 text-sm sm:text-base flex items-center gap-2">
                                <span>@region.Name</span>
                                @if (region.Name == "Tunis" || region.Name == "Sousse" || region.Name == "Sfax")
                                {
                                    <span class="text-[9px] bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded font-bold uppercase tracking-wider">Majeur</span>
                                }
                            </div>
                            <div class="text-[11px] text-slate-400 mt-0.5 flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-xs">schedule</span>
                                <span>Délai moyen : @region.EstimatedDeliveryTime</span>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Edit Form (Price, Delay, Active, Save) -->
                    <form asp-controller="Admin" asp-action="UpdateShippingRegion" method="post" class="flex flex-wrap sm:flex-nowrap items-center gap-3 shrink-0" onsubmit="handleRegionUpdate(event, this)">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@region.Id" />

                        <!-- Price Input -->
                        <div class="flex items-center gap-1.5 bg-slate-50 border border-slate-200 rounded-xl px-2.5 py-1.5 focus-within:border-emerald-600 focus-within:bg-white focus-within:ring-2 focus-within:ring-emerald-500/10 transition-all">
                            <span class="text-[11px] font-bold text-slate-400">Tarif :</span>
                            <input type="number" name="deliveryFee" step="0.5" min="0" max="100" value="@region.DeliveryFee.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" required
                                   class="w-20 bg-transparent text-xs font-bold text-slate-900 text-right focus:outline-none" />
                            <span class="text-xs font-bold text-slate-600">DT</span>
                        </div>

                        <!-- Delivery Time Input -->
                        <div class="flex items-center gap-1.5 bg-slate-50 border border-slate-200 rounded-xl px-2.5 py-1.5 focus-within:border-emerald-600 focus-within:bg-white transition-all">
                            <span class="text-[11px] font-bold text-slate-400">Délai :</span>
                            <input type="text" name="estimatedDeliveryTime" value="@region.EstimatedDeliveryTime" required
                                   class="w-24 bg-transparent text-xs text-slate-900 focus:outline-none" placeholder="24h - 48h" />
                        </div>

                        <!-- Active Toggle -->
                        <label class="flex items-center gap-2 cursor-pointer select-none px-2 py-1.5 rounded-xl hover:bg-slate-100 transition-colors">
                            <input type="checkbox" name="isActive" value="true" @(region.IsActive ? "checked" : "") class="w-4 h-4 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500" />
                            <span class="text-xs font-medium text-slate-700">Actif</span>
                        </label>

                        <!-- Submit Button -->
                        <button type="submit" class="px-3.5 py-2 bg-slate-900 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition-all flex items-center gap-1.5 shadow-2xs hover:shadow-xs">
                            <span class="material-symbols-outlined text-xs">save</span>
                            <span>Enregistrer</span>
                        </button>
                        <span class="update-indicator text-[11px] text-emerald-600 font-bold hidden">Enregistré !</span>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

<script>
    // Search filter
    document.getElementById('regionSearchInput').addEventListener('input', function(e) {
        const query = e.target.value.toLowerCase().trim();
        document.querySelectorAll('.region-item').forEach(item => {
            const name = item.getAttribute('data-name');
            if (name.includes(query)) {
                item.style.display = '';
            } else {
                item.style.display = 'none';
            }
        });
    });

    function filterRegions(type) {
        document.querySelectorAll('.region-filter-btn').forEach(b => {
            b.classList.remove('bg-slate-900', 'text-white');
            b.classList.add('bg-slate-100', 'text-slate-600');
        });
        event.target.classList.add('bg-slate-900', 'text-white');
        event.target.classList.remove('bg-slate-100', 'text-slate-600');

        document.querySelectorAll('.region-item').forEach(item => {
            if (type === 'all') {
                item.style.display = '';
            } else if (type === 'active') {
                item.style.display = item.getAttribute('data-active') === 'true' ? '' : 'none';
            }
        });
    }

    // AJAX Form Submission for Instant Updating without Page Reload
    function handleRegionUpdate(event, form) {
        event.preventDefault();
        const btn = form.querySelector('button[type="submit"]');
        const indicator = form.querySelector('.update-indicator');
        const originalText = btn.innerHTML;
        
        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined text-xs animate-spin">refresh</span> En cours...';

        const formData = new FormData(form);

        fetch(form.action, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams(formData)
        })
        .then(res => res.json())
        .then(data => {
            btn.disabled = false;
            btn.innerHTML = originalText;
            if (indicator) {
                indicator.classList.remove('hidden');
                setTimeout(() => {
                    indicator.classList.add('hidden');
                }, 2500);
            }
        })
        .catch(err => {
            btn.disabled = false;
            btn.innerHTML = originalText;
            form.submit(); // fallback to standard submit if fetch fails
        });
    }
</script>
