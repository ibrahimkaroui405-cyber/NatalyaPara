<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Administration Natalya Parapharmacie</title>
    
    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0F172A",
                        "primary-hover": "#000000",
                        "obsidian": "#090D16",
                        "surface": "#FFFFFF",
                    },
                    fontFamily: {
                        "editorial": ["Playfair Display", "Georgia", "serif"],
                        "sans": ["Plus Jakarta Sans", "Inter", "sans-serif"],
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #F8FAFC; }
        .font-editorial { font-family: 'Playfair Display', Georgia, serif; }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-[#F8FAFC] text-slate-900 min-h-screen flex antialiased">

    <!-- Admin Sidebar (Fixed Desktop) -->
    <aside class="w-64 bg-[#090D16] text-white flex-shrink-0 min-h-screen flex flex-col justify-between p-6 fixed left-0 top-0 bottom-0 z-50 hidden md:flex border-r border-slate-800">
        <div>
            <!-- Brand Logo -->
            <a asp-controller="Admin" asp-action="Index" class="flex items-center gap-3 mb-10 group">
                <div class="w-9 h-9 rounded-xl bg-white text-black flex items-center justify-center shadow-md">
                    <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 1;">spa</span>
                </div>
                <div>
                    <span class="font-editorial text-lg font-bold block leading-tight">Natalya</span>
                    <span class="text-[8.5px] font-sans font-bold tracking-[0.25em] uppercase text-slate-400">Espace Admin</span>
                </div>
            </a>

            <!-- Navigation Links -->
            <nav class="space-y-1.5 text-xs font-semibold tracking-wider uppercase">
                <a asp-controller="Admin" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "bg-white text-black font-bold shadow-sm" : "text-slate-400 hover:text-white hover:bg-slate-900")">
                    <span class="material-symbols-outlined text-lg">dashboard</span>
                    <span>Dashboard</span>
                </a>

                <a asp-controller="Admin" asp-action="Products" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Products" ? "bg-white text-black font-bold shadow-sm" : "text-slate-400 hover:text-white hover:bg-slate-900")">
                    <span class="material-symbols-outlined text-lg">inventory_2</span>
                    <span>Produits &amp; Soins</span>
                </a>

                <a asp-controller="Admin" asp-action="Stock" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Stock" ? "bg-white text-black font-bold shadow-sm" : "text-slate-400 hover:text-white hover:bg-slate-900")">
                    <span class="material-symbols-outlined text-lg">shelves</span>
                    <span class="flex-1">Gestion des Stocks</span>
                </a>

                <a asp-controller="Admin" asp-action="CreateProduct" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "CreateProduct" ? "bg-white text-black font-bold shadow-sm" : "text-slate-400 hover:text-white hover:bg-slate-900")">
                    <span class="material-symbols-outlined text-lg">add_circle</span>
                    <span>Nouveau Soin</span>
                </a>

                <a asp-controller="Admin" asp-action="Categories" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Categories" ? "bg-white text-black font-bold shadow-sm" : "text-slate-400 hover:text-white hover:bg-slate-900")">
                    <span class="material-symbols-outlined text-lg">category</span>
                    <span>Catégories</span>
                </a>

                <a asp-controller="Admin" asp-action="Brands" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Brands" ? "bg-white text-black font-bold shadow-sm" : "text-slate-400 hover:text-white hover:bg-slate-900")">
                    <span class="material-symbols-outlined text-lg">verified</span>
                    <span>Marques &amp; Labos</span>
                </a>

                <a asp-controller="Admin" asp-action="SpecialOffers" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "SpecialOffers" ? "bg-white text-black font-bold shadow-sm" : "text-slate-400 hover:text-white hover:bg-slate-900")">
                    <span class="material-symbols-outlined text-lg">local_fire_department</span>
                    <span>Offres Spéciales</span>
                </a>

                <a asp-controller="Admin" asp-action="Stories" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Stories" ? "bg-white text-black font-bold shadow-sm" : "text-slate-400 hover:text-white hover:bg-slate-900")">
                    <span class="material-symbols-outlined text-lg">smart_display</span>
                    <span>Stories Vidéo</span>
                </a>

                <a asp-controller="Admin" asp-action="Orders" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Orders" ? "bg-white text-black font-bold shadow-sm" : "text-slate-400 hover:text-white hover:bg-slate-900")">
                    <span class="material-symbols-outlined text-lg">local_shipping</span>
                    <span>Commandes</span>
                </a>
            </nav>
        </div>

        <div class="pt-6 border-t border-slate-800 space-y-3">
            <a asp-controller="Home" asp-action="Index" target="_blank" class="flex items-center justify-between px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 text-xs font-semibold transition-all">
                <span class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-base text-slate-400">storefront</span>
                    <span>Voir le Site</span>
                </span>
                <span class="material-symbols-outlined text-xs">open_in_new</span>
            </a>

            @{
                var adminName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name ?? "Pharmacien Gérant";
                var adminEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "admin@natalya.tn";
                var initials = "AD";
                if (!string.IsNullOrEmpty(adminName))
                {
                    var parts = adminName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                    initials = parts.Length > 1 ? $"{parts[0][0]}{parts[1][0]}".ToUpper() : adminName.Substring(0, Math.Min(2, adminName.Length)).ToUpper();
                }
            }

            <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-3 space-y-2.5">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-emerald-700 text-white flex items-center justify-center text-xs font-bold shrink-0 shadow-sm">
                        @initials
                    </div>
                    <div class="text-[11px] leading-tight min-w-0 flex-1">
                        <div class="font-bold text-white truncate">@adminName</div>
                        <div class="text-emerald-400 text-[9.5px] font-medium flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                            <span>En ligne</span>
                        </div>
                    </div>
                </div>

                <form asp-controller="Admin" asp-action="Logout" method="post" class="w-full">
                    <button type="submit" class="w-full flex items-center justify-center gap-2 px-3 py-1.5 rounded-xl bg-red-950/40 hover:bg-red-900/60 border border-red-800/40 text-red-300 hover:text-red-100 text-[11px] font-semibold transition-all">
                        <span class="material-symbols-outlined text-sm">logout</span>
                        <span>Déconnexion</span>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 md:ml-64 flex flex-col min-h-screen">
        <!-- Top Admin Header -->
        <header class="h-16 bg-white border-b border-slate-200 px-6 flex items-center justify-between sticky top-0 z-40">
            <div class="flex items-center gap-4">
                <button id="mobileAdminMenuBtn" class="md:hidden text-slate-700 p-2 rounded-lg hover:bg-slate-100">
                    <span class="material-symbols-outlined">menu</span>
                </button>
                <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest hidden sm:block">
                    Portail de Gestion Officinale &bull; <span class="text-emerald-700 font-bold">@adminName</span>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <a asp-controller="Admin" asp-action="CreateProduct" class="hidden sm:inline-flex items-center gap-2 bg-black hover:bg-slate-800 text-white text-xs font-bold uppercase tracking-wider px-4 py-2 rounded-xl transition-all shadow-sm">
                    <span class="material-symbols-outlined text-sm">add</span>
                    <span>Ajouter un Soin</span>
                </a>
                <a asp-controller="Home" asp-action="Index" class="text-slate-600 hover:text-black p-2 rounded-lg hover:bg-slate-100 transition-colors" title="Boutique publique">
                    <span class="material-symbols-outlined">storefront</span>
                </a>
                <a asp-controller="Admin" asp-action="Logout" class="inline-flex items-center gap-1.5 text-red-700 hover:text-red-900 bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded-xl text-xs font-bold transition-all" title="Se déconnecter">
                    <span class="material-symbols-outlined text-sm">logout</span>
                    <span class="hidden md:inline">Quitter</span>
                </a>
            </div>
        </header>

        <!-- Flash Messages -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mx-6 mt-6 p-4 rounded-xl bg-slate-900 text-white flex items-center justify-between shadow-lg text-xs font-medium animate-fadeIn">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-emerald-400 text-lg">check_circle</span>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
                <button onclick="this.parentElement.remove()" class="text-slate-400 hover:text-white">
                    <span class="material-symbols-outlined text-sm">close</span>
                </button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mx-6 mt-6 p-4 rounded-xl bg-red-900 text-white flex items-center justify-between shadow-lg text-xs font-medium animate-fadeIn">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-red-300 text-lg">error</span>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
                <button onclick="this.parentElement.remove()" class="text-slate-300 hover:text-white">
                    <span class="material-symbols-outlined text-sm">close</span>
                </button>
            </div>
        }

        <!-- Page View Body -->
        <main class="p-6 md:p-8 flex-1">
            @RenderBody()
        </main>
    </div>

    <!-- Mobile Admin Drawer Navigation -->
    <div id="mobileAdminDrawer" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden md:hidden">
        <div class="bg-[#090D16] text-white w-72 max-w-[85vw] h-full p-6 shadow-2xl flex flex-col justify-between border-r border-slate-800 overflow-y-auto">
            <div>
                <!-- Header -->
                <div class="flex items-center justify-between pb-5 border-b border-slate-800 mb-6">
                    <a asp-controller="Admin" asp-action="Index" class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-xl bg-white text-black flex items-center justify-center shadow-md">
                            <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">spa</span>
                        </div>
                        <div>
                            <span class="font-editorial text-base font-bold block leading-tight">Natalya</span>
                            <span class="text-[7.5px] font-sans font-bold tracking-[0.2em] uppercase text-slate-400">Espace Admin</span>
                        </div>
                    </a>
                    <button id="closeAdminDrawerBtn" class="text-slate-400 hover:text-white p-1.5 rounded-lg hover:bg-slate-800 transition-colors" aria-label="Fermer le menu">
                        <span class="material-symbols-outlined text-xl">close</span>
                    </button>
                </div>

                <!-- Navigation Links -->
                <nav class="space-y-1 text-xs font-semibold tracking-wider uppercase">
                    <a asp-controller="Admin" asp-action="Index" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "bg-white text-black font-bold shadow-sm" : "text-slate-400 hover:text-white hover:bg-slate-900")">
                        <span class="material-symbols-outlined text-base">dashboard</span>
                        <span>Dashboard</span>
                    </a>

                    <a asp-controller="Admin" asp-action="Products" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Products" ? "bg-white text-black font-bold shadow-sm" : "text-slate-400 hover:text-white hover:bg-slate-900")">
                        <span class="material-symbols-outlined text-base">inventory_2</span>
                        <span>Produits &amp; Soins</span>
                    </a>

                    <a asp-controller="Admin" asp-action="Stock" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Stock" ? "bg-white text-black font-bold shadow-sm" : "text-slate-400 hover:text-white hover:bg-slate-900")">
                        <span class="material-symbols-outlined text-base">shelves</span>
                        <span>Gestion Stocks</span>
                    </a>

                    <a asp-controller="Admin" asp-action="CreateProduct" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "CreateProduct" ? "bg-white text-black font-bold shadow-sm" : "text-slate-400 hover:text-white hover:bg-slate-900")">
                        <span class="material-symbols-outlined text-base">add_circle</span>
                        <span>Nouveau Soin</span>
                    </a>

                    <a asp-controller="Admin" asp-action="Categories" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Categories" ? "bg-white text-black font-bold shadow-sm" : "text-slate-400 hover:text-white hover:bg-slate-900")">
                        <span class="material-symbols-outlined text-base">category</span>
                        <span>Catégories</span>
                    </a>

                    <a asp-controller="Admin" asp-action="Brands" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Brands" ? "bg-white text-black font-bold shadow-sm" : "text-slate-400 hover:text-white hover:bg-slate-900")">
                        <span class="material-symbols-outlined text-base">verified</span>
                        <span>Marques &amp; Labos</span>
                    </a>

                    <a asp-controller="Admin" asp-action="SpecialOffers" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "SpecialOffers" ? "bg-white text-black font-bold shadow-sm" : "text-slate-400 hover:text-white hover:bg-slate-900")">
                        <span class="material-symbols-outlined text-base">local_fire_department</span>
                        <span>Offres Spéciales</span>
                    </a>

                    <a asp-controller="Admin" asp-action="Stories" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Stories" ? "bg-white text-black font-bold shadow-sm" : "text-slate-400 hover:text-white hover:bg-slate-900")">
                        <span class="material-symbols-outlined text-base">smart_display</span>
                        <span>Stories Vidéo</span>
                    </a>

                    <a asp-controller="Admin" asp-action="Orders" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Orders" ? "bg-white text-black font-bold shadow-sm" : "text-slate-400 hover:text-white hover:bg-slate-900")">
                        <span class="material-symbols-outlined text-base">local_shipping</span>
                        <span>Commandes</span>
                    </a>
                </nav>
            </div>

            <div class="pt-5 border-t border-slate-800 space-y-3">
                <a asp-controller="Home" asp-action="Index" target="_blank" class="flex items-center justify-between px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 text-xs font-semibold transition-all">
                    <span class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm text-slate-400">storefront</span>
                        <span>Voir le Site</span>
                    </span>
                    <span class="material-symbols-outlined text-xs">open_in_new</span>
                </a>

                <div class="flex items-center gap-3 p-2 rounded-xl bg-slate-900/80 border border-slate-800">
                    <div class="w-8 h-8 rounded-full bg-emerald-700 text-white flex items-center justify-center text-xs font-bold shrink-0">
                        @initials
                    </div>
                    <div class="text-[11px] leading-tight min-w-0 flex-1">
                        <div class="font-bold text-white truncate">@adminName</div>
                        <div class="text-emerald-400 text-[9.5px]">En ligne</div>
                    </div>
                </div>

                <form asp-controller="Admin" asp-action="Logout" method="post" class="w-full">
                    <button type="submit" class="w-full flex items-center justify-center gap-2 px-3 py-2 rounded-xl bg-red-950/40 hover:bg-red-900/60 border border-red-800/40 text-red-300 text-xs font-semibold transition-all">
                        <span class="material-symbols-outlined text-sm">logout</span>
                        <span>Se Déconnecter</span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const mobileAdminBtn = document.getElementById('mobileAdminMenuBtn');
            const closeAdminBtn = document.getElementById('closeAdminDrawerBtn');
            const mobileAdminDrawer = document.getElementById('mobileAdminDrawer');

            if (mobileAdminBtn && mobileAdminDrawer) {
                mobileAdminBtn.addEventListener('click', () => {
                    mobileAdminDrawer.classList.remove('hidden');
                });
            }

            if (closeAdminBtn && mobileAdminDrawer) {
                closeAdminBtn.addEventListener('click', () => {
                    mobileAdminDrawer.classList.add('hidden');
                });
            }

            if (mobileAdminDrawer) {
                mobileAdminDrawer.addEventListener('click', (e) => {
                    if (e.target === mobileAdminDrawer) {
                        mobileAdminDrawer.classList.add('hidden');
                    }
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
