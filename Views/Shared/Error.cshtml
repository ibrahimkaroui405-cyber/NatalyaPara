@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5 my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 text-center">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="mb-4">
                    @if (Model.StatusCode == 404)
                    {
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light text-primary mb-3" style="width: 90px; height: 90px; font-size: 40px; background-color: #fdf5f0 !important; color: #8b5e3c !important;">
                            <i class="bi bi-search"></i>
                        </div>
                    }
                    else if (Model.StatusCode == 403 || Model.StatusCode == 401)
                    {
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light text-warning mb-3" style="width: 90px; height: 90px; font-size: 40px; background-color: #fff9e6 !important; color: #b7791f !important;">
                            <i class="bi bi-shield-lock"></i>
                        </div>
                    }
                    else
                    {
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light text-danger mb-3" style="width: 90px; height: 90px; font-size: 40px; background-color: #fef2f2 !important; color: #dc2626 !important;">
                            <i class="bi bi-heart-pulse"></i>
                        </div>
                    }
                </div>

                <span class="badge bg-light text-muted px-3 py-2 rounded-pill mb-2 align-self-center font-monospace" style="letter-spacing: 1px; font-size: 13px;">
                    CODE D'ÉTAT @Model.StatusCode
                </span>

                <h1 class="h3 fw-bold mb-3" style="color: #2d2926;">@Model.Title</h1>

                <p class="text-muted fs-6 mb-4" style="line-height: 1.6;">
                    @Model.Description
                </p>

                <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                    <a href="/" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow-sm" style="background-color: #8b5e3c; border-color: #8b5e3c;">
                        <i class="bi bi-house-door me-2"></i>Retour à l'accueil
                    </a>
                    <a href="/Products" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold">
                        <i class="bi bi-grid me-2"></i>Explorer nos soins
                    </a>
                </div>

                @if (Model.ShowRequestId)
                {
                    <div class="mt-4 pt-3 border-top text-muted small">
                        <span>Référence technique : <code class="text-secondary font-monospace">@Model.RequestId</code></span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
