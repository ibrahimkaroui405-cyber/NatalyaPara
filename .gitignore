# Build and temporary files
bin/
obj/
publish/
publish.zip
*.user
*.suo
.vs/
.vscode/

# Python cache & scratch scripts
__pycache__/
*.pyc

# SQLite database files - DO NOT TRACK so production data is never overwritten by local changes
*.db
*.db-shm
*.db-wal
*.sqlite
App_Data/*.db
App_Data/*.db-shm
App_Data/*.db-wal
!App_Data/.gitkeep
